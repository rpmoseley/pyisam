pyctype_sources = ssmod.source_set()
pyctype_sources.add(['__init__.py', 'common.py'])
pyctype_sources.add(when: 'ifisam', if_true: 'ifisam.py')
pyctype_sources.add(when: 'vbisam', if_true: 'vbisam.py')
pyctype_sources.add(when: 'disam', if_true: 'disam.py')
py.install_sources(pyctype_sources.all_sources(), install_tag: 'runtime', subdir: 'pyisam/backend/ctypes')
